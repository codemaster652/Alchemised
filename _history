redients[i][0] === str) {\n            return Ingredients[i];\n        }\n    }\nconsole.log(\"No output value\")\n    return []\n}\nfunction createPotion (Ingredient1: string, Ingredient2: string, Base: any[]) {\n    ing1 = getIngredient(Ingredient1)\n    ing2 = getIngredient(Ingredient2)\n    matchingEffects = []\n    aeffects = []\n    if (ing1.length == 0 || ing2.length == 0) {\n        console.log(\"Invalid ingredient!\")\n        return []\n    }\n    for (let a = 1; a <= 4; a++) {\n        for (let b = 1; b <= 4; b++) {\n            if (\n                ing1[a] == ing2[b] &&\n                !includes(matchingEffects,ing1[a])\n            ) {\n                matchingEffects.push(ing1[a]);\n            }\n        }\n    }\n\n    if (matchingEffects.length > 1) {\n        let effect = matchingEffects[Math.floor(Math.random() * matchingEffects.length)]\n    } else if (matchingEffects.length == 0) {\n        aeffects = [\n        ing1[1],\n        ing1[2],\n        ing1[3],\n        ing1[4],\n        ing2[1],\n        ing2[2],\n        ing2[3],\n        ing2[4]\n        ]\n        let effect = aeffects[Math.floor(Math.random() * aeffects.length)]\n    } else {\n        let effect = matchingEffects[0]\n    }\n    let sideffect;\n    if (ing1[5] > ing2[5]){\n        sideffect = ing1[6]\n    } else {\n        sideffect = ing2[6]\n    }\n    let strength = (ing1[5] + ing2[5])/2\n    return [effect, sideffect, strength]\n}\nfunction includes (arr: string[], str: string) {\n    return arr.indexOf(str) != -1\n}\nlet effect = \"\"\nlet aeffects: number[] = []\nlet matchingEffects: any[] = []\nlet Ingredients: any[][] = []\nlet ing1: any[] = []\nlet ing2: any[] = []\ntiles.setCurrentTilemap(tilemap`level1`)\nlet ExamplePotion = [\"Effect(str)\", \"Strength(num)\", \"EffectArea(num)\"]\nIngredients = [\n[\n\"Name\",\n\"E1\",\n\"E2\",\n\"E3\",\n\"E4\",\n\"BaseStrength\",\n\"Side-Effect\",\n\"Rarity\"\n],\n[\n\"Mercury\",\n\"Poison\",\n\"Fire-Resistance\",\n\"Teeth-Growth\