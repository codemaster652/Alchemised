ect, sideffect, strength]\n}\nlet strength = 0\nlet aeffects: number[] = []\nlet ing2: any[] = []\nlet ing1: any[] = []\nlet Ingredients: any[][] = []\nlet matchingEffects: any[] = []\nlet effect2 = \"\"\ntiles.setCurrentTilemap(tilemap`level1`)\nlet ExamplePotion = [\"Effect(str)\", \"Strength(num)\", \"EffectArea(num)\"]\nIngredients = [\n[\n\"Name\",\n\"E1\",\n\"E2\",\n\"E3\",\n\"E4\",\n\"BaseStrength\",\n\"Side-Effect\",\n\"Rarity\"\n],\n[\n\"Mercury\",\n\"Poison\",\n\"Fire-Resistance\",\n\"Teeth-Growth\",\n\"Light\",\n50,\n\"D-Poison\",\n\"Common\"\n],\n[\n\"Sulphur\",\n\"Fire-Breath\",\n\"Light\",\n\"Charm\",\n\"Strength\",\n50,\n\"D-Defense\",\n\"Common\"\n],\n[\n\"Salt\",\n\"Resistance\",\n\"Charm\",\n\"Silence\",\n\"Heal\",\n50,\n\"D-Attack\",\n\"Common\"\n],\n[\n\"Name\",\n\"E1\",\n\"E2\",\n\"E3\",\n\"E4\",\n0,\n\"D-\",\n\"Common\"\n]\n]\nconsole.log(createPotion(\"Salt\", \"Mercury\", []))\nlet Test = shader.createRectangularShaderSprite(16, 16, shader.ShadeLevel.Four)\n","README.md":" ","assets.json":"","tilemap.g.jres":"{\n    \"transparency16\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true\n    },\n    \"level1\": {\n        \"id\": \"level1\",\n        \"mimeType\": \"application/mkcd-tilemap\",\n        \"data\": \"\",\n        \"tileset\": [\n            \"myTiles.transparency16\",\n            \"sprites.dungeon.darkGroundCenter\",\n            \"sprites.dungeon.darkGroundSouth\",\n            \"sprites.dungeon.darkGroundSouthWest0\",\n            \"sprites.dungeon.darkGroundSouthEast0\"\n        ],\n        \"displayName\": \"level1\"\n    },\n    \"*\": {\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"dataEncoding\": \"base64\",\n        \"namespace\": \"myTiles\"\n    }\n}","tilemap.g.ts":"","images.g.