 0) {\n        console.log(\"Invalid ingredient!\")\n        return []\n    }\n    for (let a = 1; a <= 4; a++) {\n        for (let b = 1; b <= 4; b++) {\n            if (\n                ing1[a] == ing2[b] &&\n                !includes(matchingEffects,ing1[a])\n            ) {\n                matchingEffects.push(ing1[a]);\n            }\n        }\n    }\n\n    if (matchingEffects.length > 1) {\n        let effect = matchingEffects[Math.floor(Math.random() * matchingEffects.length)]\n    } else if (matchingEffects.length == 0) {\n        aeffects = [\n        ing1[1],\n        ing1[2],\n        ing1[3],\n        ing1[4],\n        ing2[1],\n        ing2[2],\n        ing2[3],\n        ing2[4]\n        ]\n        let effect = aeffects[Math.floor(Math.random() * aeffects.length)]\n    } else {\n        let effect = matchingEffects[0]\n    }\n    let sideffect;\n    if (ing1[5] > ing2[5]){\n        sideffect = ing1[6]\n    } else {\n        sideffect = ing2[6]\n    }\n    let strength = (ing1[5] + ing2[5])/2\n    return [effect, sideffect, strength]\n}\nfunction includes (arr: string[], str: string) {\n    return arr.indexOf(str) != -1\n}\nlet effect = \"\"\nlet aeffects: number[] = []\nlet matchingEffects: any[] = []\nlet Ingredients: any[][] = []\nlet ing1: any[] = []\nlet ing2: any[] = []\ntiles.setCurrentTilemap(tilemap`level1`)\nlet ExamplePotion = [\"Effect(str)\", \"Strength(num)\", \"EffectArea(num)\"]\nIngredients = [\n[\n\"Name\",\n\"E1\",\n\"E2\",\n\"E3\",\n\"E4\",\n\"BaseStrength\",\n\"Side-Effect\",\n\"Rarity\"\n],\n[\n\"Mercury\",\n\"Poison\",\n\"Fire-Resistance\",\n\"Teeth-Growth\",\n\"Light\",\n50,\n\"D-Poison\",\n\"Common\"\n],\n[\n\"Sulphur\",\n\"Fire-Breath\",\n\"Light\",\n\"Charm\",\n\"Strength\",\n50,\n\"D-Defense\",\n\"Common\"\n],\n[\n\"Salt\",\n\"Resistance\",\n\"Charm\",\n\"Silence\",\n\"Heal\",\n50,\n\"D-Attack\",\n\"Common\"\n],\n[\n\"Name\",\n\"E1\",\n\"E2\",\n\"E3\",\n\"E4\",\n0,\n\"D-\",\n\"Common\"\n]\n]\nconsole.log(createPotion(\"Salt\", \"Sulphur\", []))","README.md":" ","assets.json":"","tilemap.g.jres":"{\n    \"transparency16\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true\n    },\n    \"level1\": {\n        \"id\": \"level1\",\n        \"mimeType\": \"application/mkcd-tilemap\",\n        \"data\": \"\",\n        \"tileset\": [\n            \"myTiles.transparency16\",\n            \"sprites.dungeon.darkGroundCenter\",\n            \"sprites.dungeon.darkGroundSouth\",\n            \"sprites.dungeon.darkGroundSouthWest0\",\n            \"sprites.dungeon.darkGroundSouthEast0\"\n        ],\n        \"displayName\": \"level1\"\n    },\n    \"*\": {\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"dataEncoding\": \"base64\",\n        \"namespace\": \"myTiles\"\n    }\n}","tilemap.g.ts":"","pxt.json":"{\n    \"name\": \"Magic System Test\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\",\n        \"tilemap.g.jres\",\n        \"tilemap.g.ts\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1794587087101,"editorVersion":"4.1.27","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"=Ay9OeAh=Gi}kFH)=mng\">ing1</variable><variable id=\"c[UE+UF|1Iiw*fAN^sR=\">ing2</variable><variable id=\"^ME}dNljus:APWe7q/M_\">matchingEffects</variable><variable id=\"cxDAj/7DWZd{,2ZJb*Z,\">aeffects</variable><variable id=\"4+WrbT)iX#qe@mRgV0gF\">effect</variable><variable id=\"i9A+%c4BK?2Asq;P)V]$\">ExamplePotion</variable><variable id=\"e5woU6Q,rRO2{r[[CG!P\">Ingredients</variable></variables><comment x=\"3395.21875\" y=\"20\" w=\"480\" h=\"120\">\nBaseSt